---
import BaseLayout from '../layouts/BaseLayout.astro';

// Hobby categories. Add items under each category as you like.
// "Reading" has sample entries to show how it looks.
type HobbyItem = {
  title: string;
  meta?: string; // e.g. author, medium, tool
  note?: string;
  status?: string; // e.g. Reading, Finished, To read
};

const categories: { name: string; emoji: string; items: HobbyItem[] }[] = [
  {
    name: 'Reading',
    emoji: '📚',
    items: [
      {
        title: 'Thinking, Fast and Slow',
        meta: 'Daniel Kahneman',
        note: 'On the two systems that drive the way we think.',
        status: 'Reading',
      },
      {
        title: 'Atomic Habits',
        meta: 'James Clear',
        note: 'Small habits, remarkable results.',
        status: 'Finished',
      },
      {
        title: 'The Alignment Problem',
        meta: 'Brian Christian',
        note: 'Where machine learning meets human values.',
        status: 'To read',
      },
    ],
  },
  { name: 'Art', emoji: '🎨', items: [] },
  { name: 'Coloring', emoji: '🖍️', items: [] },
  { name: 'Journaling', emoji: '📓', items: [] },
  { name: 'Paper Reading', emoji: '📄', items: [] },
];
---

<BaseLayout title="Hobby" description="Things I enjoy away from the keyboard.">
  <header class="mb-8">
    <h1 class="text-gradient inline-block text-3xl font-extrabold sm:text-4xl">Hobby</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-400">The things I enjoy away from the keyboard. Pick a category.</p>
  </header>

  <!-- Category buttons -->
  <div id="hobby-filter" class="mb-8 flex flex-wrap gap-2">
    <button
      class="hobby-btn filter-chip rounded-full bg-primary-600 px-3.5 py-1.5 text-sm font-medium text-white"
      data-cat="all"
      aria-pressed="true"
    >
      All
    </button>
    {categories.map((cat) => (
      <button
        class="hobby-btn filter-chip rounded-full bg-gray-100 px-3.5 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700"
        data-cat={cat.name}
        aria-pressed="false"
      >
        <span class="mr-1">{cat.emoji}</span>{cat.name}
      </button>
    ))}
  </div>

  <!-- Sections (one per category). "All" shows every non-empty category. -->
  {categories.map((cat) => (
    <section
      class={`hobby-section mb-10 ${cat.items.length ? '' : 'hidden'}`}
      data-cat={cat.name}
      data-empty={cat.items.length ? 'false' : 'true'}
    >
      <h2 class="mb-4 text-lg font-bold text-gray-900 dark:text-gray-100">
        <span class="mr-1">{cat.emoji}</span>{cat.name}
      </h2>
      {cat.items.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2">
          {cat.items.map((item) => (
            <div class="rounded-xl border border-gray-100 p-5 shadow-sm transition hover:border-primary-200 hover:shadow-md dark:border-gray-800 dark:bg-gray-900 dark:hover:border-primary-700">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100">{item.title}</h3>
                  {item.meta && <p class="text-sm font-medium text-gray-500 dark:text-gray-400">{item.meta}</p>}
                </div>
                {item.status && (
                  <span class="shrink-0 rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-500/15 dark:text-primary-300">
                    {item.status}
                  </span>
                )}
              </div>
              {item.note && <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-400">{item.note}</p>}
            </div>
          ))}
        </div>
      ) : (
        <div class="rounded-xl border border-dashed border-gray-200 p-10 text-center text-gray-500 dark:border-gray-700 dark:text-gray-400">
          <div class="text-3xl">{cat.emoji}</div>
          <p class="mt-2 text-sm">Nothing here yet — coming soon.</p>
        </div>
      )}
    </section>
  ))}
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.hobby-btn');
  const sections = document.querySelectorAll<HTMLElement>('.hobby-section');
  const activeClasses = ['bg-primary-600', 'text-white'];
  const idleClasses = [
    'bg-gray-100',
    'text-gray-700',
    'hover:bg-gray-200',
    'dark:bg-gray-800',
    'dark:text-gray-300',
    'dark:hover:bg-gray-700',
  ];

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat;
      buttons.forEach((b) => {
        b.classList.remove(...activeClasses);
        b.classList.add(...idleClasses);
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove(...idleClasses);
      btn.classList.add(...activeClasses);
      btn.setAttribute('aria-pressed', 'true');
      sections.forEach((s) => {
        const isEmpty = s.dataset.empty === 'true';
        // "All" shows every non-empty category; a specific tab shows just that
        // category (including its "coming soon" note if it's empty).
        const show = cat === 'all' ? !isEmpty : s.dataset.cat === cat;
        s.classList.toggle('hidden', !show);
      });
    });
  });
</script>
