---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroOrbit from '../components/HeroOrbit.astro';
import { SITE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);

const featured = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="grid items-center gap-10 py-6 sm:py-10 lg:grid-cols-[1fr_auto]">
    <div class="max-w-xl">
      <p class="text-xs font-medium text-primary-600 dark:text-primary-400">Founder &amp; AI Researcher at Cognivia AI</p>
      <h1 class="mt-2 text-3xl font-extrabold leading-tight sm:text-4xl">
        Hi, I'm <span class="text-gradient">Nana</span>.
      </h1>
      <p class="mt-2 text-sm font-medium text-gray-500 dark:text-gray-400">
        AI/ML Engineer · Data Scientist (NLP) · Master of Computer Science
      </p>
      <p class="mt-4 text-sm leading-6 text-gray-600 dark:text-gray-400">
        I'm an AI/ML Engineer and Data Scientist with a foundation in Natural Language
        Processing and applied research. I enjoy working at the intersection of data,
        technology, and human behavior — building thoughtful, interpretable AI systems
        that support real-world decision-making.
      </p>
      <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-400">
        Currently I'm developing <span class="font-semibold text-gray-800 dark:text-gray-200">Cognivia</span>,
        an independent AI initiative focused on cognition, emotion, and human-centered
        intelligence.
      </p>
    </div>

    <!-- Interactive space scene (center intentionally empty) -->
    <div class="justify-self-center lg:justify-self-end">
      <HeroOrbit class="w-72 sm:w-80 lg:w-[440px]" />
    </div>
  </section>

  <!-- Featured projects -->
  {featured.length > 0 && (
    <section class="mt-14">
      <div class="mb-5 flex items-baseline justify-between">
        <h2 class="text-2xl font-bold">Featured projects</h2>
        <a href={`${base}/projects/`} class="link-grad text-sm text-primary-600 dark:text-primary-400">See all →</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {featured.map((p) => (
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            url={`${base}/projects/${p.slug}/`}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Latest posts -->
  {posts.length > 0 && (
    <section class="mt-14">
      <div class="mb-5 flex items-baseline justify-between">
        <h2 class="text-2xl font-bold">Latest posts</h2>
        <a href={`${base}/blog/`} class="link-grad text-sm text-primary-600 dark:text-primary-400">See all →</a>
      </div>
      <div class="grid gap-4">
        {posts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            url={`${base}/blog/${post.slug}/`}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
