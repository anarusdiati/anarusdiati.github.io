---
import Tag from './Tag.astro';
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  url: string;
}
const { title, description, date, tags, url } = Astro.props;
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---
<a
  href={url}
  class="reveal group block rounded-xl border border-gray-100 p-5 shadow-sm transition hover:border-primary-200 hover:shadow-md"
>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-lg font-bold text-gray-900 group-hover:text-primary-600">{title}</h3>
    <time class="shrink-0 text-xs text-gray-400">{formatted}</time>
  </div>
  <p class="mt-2 text-sm leading-6 text-gray-600">{description}</p>
  <div class="mt-3 flex flex-wrap gap-1.5">
    {tags.map((t) => <Tag label={t} />)}
  </div>
</a>
